{
  "name": "xiaocaoge",
  "private": true,
  "description": "My blog",
  "keywords": [
    "astro"
  ],
  "license": "UNLICENSED",
  "main": "n/a",
  "scripts": {
    "prepare": "husky",
    "dev": "astro dev --port 9527",
    "build": "astro build",
    "preview": "astro preview --port 9527",
    "lint": "oxlint src --ignore-pattern \"**/*.astro\"",
    "format": "oxfmt .",
    "lint-staged": "lint-staged"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.12",
    "astro": "^5.7.2",
    "dayjs": "^1.11.13",
    "gray-matter": "^4.0.3",
    "lodash": "^4.17.21",
    "markdown-it": "^14.1.0",
    "normalize.css": "^8.0.1",
    "prismjs": "^1.29.0",
    "url-join": "^4.0.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "oxfmt": "^0.44.0",
    "oxlint": "^0.16.9",
    "typescript": "^5.8.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,json}": [
      "oxfmt --write",
      "oxlint"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.8.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
